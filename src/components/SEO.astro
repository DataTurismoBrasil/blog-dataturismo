---
import { SITE } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  /** Caminho absoluto da imagem OG (1200×630). */
  ogImage: { url: string; alt: string; width?: number; height?: number };
  type?: 'website' | 'article';
  article?: { publishedTime: Date; modifiedTime: Date; section?: string; tags?: string[] };
  noindex?: boolean;
  jsonLd?: object[];
}

const { title, description, ogImage, type = 'website', article, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const { width = 1200, height = 630 } = ogImage;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={SITE.nome} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage.url} />
<meta property="og:image:secure_url" content={ogImage.url} />
<meta property="og:image:width" content={String(width)} />
<meta property="og:image:height" content={String(height)} />
<meta property="og:image:alt" content={ogImage.alt} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      <meta property="article:author" content={SITE.autora.url} />
      {article.section && <meta property="article:section" content={article.section} />}
      {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.url} />
<meta name="twitter:image:alt" content={ogImage.alt} />

{jsonLd.map((dado) => <script type="application/ld+json" is:inline set:html={JSON.stringify(dado)} />)}
