---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardArtigo from '../../components/CardArtigo.astro';
import { getArtigos } from '../../lib/artigos';
import { CATEGORIAS, type Categoria } from '../../lib/categorias';
import { SITE } from '../../lib/site';

// Só gera páginas de categorias que têm artigos publicados (evita páginas vazias indexadas).
export const getStaticPaths = (async () => {
  const artigos = await getArtigos();
  return (Object.keys(CATEGORIAS) as Categoria[])
    .map((categoria) => ({ params: { categoria }, props: { artigos: artigos.filter((a) => a.data.category === categoria) } }))
    .filter(({ props }) => props.artigos.length > 0);
}) satisfies GetStaticPaths;

const { categoria } = Astro.params as { categoria: Categoria };
const { artigos } = Astro.props;
const { nome, descricao } = CATEGORIAS[categoria];
const url = `${SITE.url}/categorias/${categoria}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${nome} | ${SITE.nome}`,
    description: descricao,
    url,
    inLanguage: SITE.lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: nome, item: url },
    ],
  },
];
---

<BaseLayout title={`${nome} | ${SITE.nome}`} description={descricao} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-5 pt-10">
    <nav aria-label="Trilha de navegação" class="text-sm text-cinza">
      <ol class="flex flex-wrap gap-2">
        <li><a href="/" class="hover:text-verde-700 hover:underline">Início</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="text-marinho-900">{nome}</li>
      </ol>
    </nav>
    <header class="mt-6 max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.2em] text-verde-700 uppercase">Categoria</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-marinho-900 md:text-4xl">{nome}</h1>
      <p class="mt-3 font-serif text-lg leading-relaxed text-cinza">{descricao}</p>
    </header>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {artigos.map((artigo) => <CardArtigo artigo={artigo} />)}
    </div>
  </div>
</BaseLayout>
