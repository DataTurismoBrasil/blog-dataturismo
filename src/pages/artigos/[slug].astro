---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardArtigo from '../../components/CardArtigo.astro';
import { formatarData, getArtigos, tempoDeLeitura, type Artigo } from '../../lib/artigos';
import { nomeCategoria } from '../../lib/categorias';
import { SITE } from '../../lib/site';
import { BIO_RESUMIDA, pessoaJsonLd } from '../../lib/autora';

export const getStaticPaths = (async () => {
  const artigos = await getArtigos();
  return artigos.map((artigo) => ({
    params: { slug: artigo.id },
    props: {
      artigo,
      relacionados: artigos.filter((a) => a.id !== artigo.id && a.data.category === artigo.data.category).slice(0, 2),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  artigo: Artigo;
  relacionados: Artigo[];
}

const { artigo, relacionados } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, image, imageAlt, draft } = artigo.data;
const { Content } = await render(artigo);

const url = `${SITE.url}/artigos/${artigo.id}/`;
const modificado = updatedDate ?? pubDate;
const categoria = nomeCategoria(category);

// og:image: capa do artigo recortada em 1200×630; sem capa, usa a imagem gerada no build em /og/[slug].png
const ogImage = image
  ? {
      url: new URL((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 85 })).src, SITE.url)
        .href,
      alt: imageAlt ?? title,
    }
  : { url: `${SITE.url}/og/${artigo.id}.png`, alt: title };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: [ogImage.url],
    datePublished: pubDate.toISOString(),
    dateModified: modificado.toISOString(),
    inLanguage: SITE.lang,
    articleSection: categoria,
    keywords: tags.join(', '),
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: pessoaJsonLd(),
    publisher: {
      '@type': 'Organization',
      name: SITE.organizacao.nome,
      url: SITE.organizacao.url,
      logo: { '@type': 'ImageObject', url: SITE.organizacao.logo },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: categoria, item: `${SITE.url}/categorias/${category}/` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  ogImage={ogImage}
  article={{ publishedTime: pubDate, modifiedTime: modificado, section: categoria, tags }}
  jsonLd={jsonLd}
  rascunho={draft}
>
  <article class="mx-auto max-w-3xl px-5 pt-10">
    <nav aria-label="Trilha de navegação" class="text-sm text-cinza">
      <ol class="flex flex-wrap gap-2">
        <li><a href="/" class="hover:text-verde-700 hover:underline">Início</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={`/categorias/${category}/`} class="hover:text-verde-700 hover:underline">{categoria}</a></li>
      </ol>
    </nav>

    <header class="mt-6">
      <h1 class="text-3xl leading-tight font-bold tracking-tight text-marinho-900 md:text-[2.6rem]">{title}</h1>
      <p class="mt-4 font-serif text-xl leading-relaxed text-cinza">{description}</p>
      <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 border-y border-linha py-3 text-sm text-cinza">
        <span>
          Por <a href="/sobre/" rel="author" class="font-semibold text-marinho-900 underline-offset-2 hover:text-verde-700 hover:underline"
            >{SITE.autora.nome}</a
          >
        </span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{formatarData(pubDate)}</time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Atualizado em <time datetime={updatedDate.toISOString()}>{formatarData(updatedDate)}</time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{tempoDeLeitura(artigo.body)} min de leitura</span>
      </p>
    </header>

    {
      image && (
        <Image
          src={image}
          alt={imageAlt ?? ''}
          widths={[480, 720, 1200]}
          sizes="(min-width: 768px) 720px, 100vw"
          class="mt-8 aspect-[1200/630] w-full rounded-lg object-cover"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    <div class="artigo-corpo com-referencias mt-10">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-12 flex flex-wrap gap-2" aria-label="Tags">
          {tags.map((tag) => (
            <li class="rounded-full bg-marinho-50 px-3 py-1 text-sm text-marinho-800">{tag}</li>
          ))}
        </ul>
      )
    }

    <aside class="mt-12 rounded-lg border border-linha bg-marinho-50 p-6" aria-label="Sobre a autora">
      <p class="text-sm font-semibold tracking-[0.15em] text-verde-700 uppercase">Sobre a autora</p>
      <p class="mt-2 text-lg font-bold text-marinho-900">{SITE.autora.nome}</p>
      <p class="mt-1 font-serif leading-relaxed text-cinza">{BIO_RESUMIDA}</p>
      <a href="/sobre/" class="mt-3 inline-block text-sm font-semibold text-verde-700 hover:underline">Conheça a trajetória →</a>
    </aside>
  </article>

  {
    relacionados.length > 0 && (
      <section aria-labelledby="titulo-relacionados" class="mx-auto mt-16 max-w-6xl px-5">
        <h2 id="titulo-relacionados" class="text-2xl font-bold tracking-tight text-marinho-900">
          Leia também em {categoria}
        </h2>
        <div class="mt-6 grid gap-8 sm:grid-cols-2">
          {relacionados.map((a) => (
            <CardArtigo artigo={a} nivel="h3" />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
