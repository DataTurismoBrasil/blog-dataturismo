---
import '../styles/global.css';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';

type Props = Omit<SEOProps, 'ogImage'> & { ogImage?: SEOProps['ogImage']; rascunho?: boolean };

const { rascunho = false, ogImage, ...seo } = Astro.props;
const imagemPadrao = {
  url: new URL('/og/blog.png', Astro.site).href,
  alt: `${SITE.nome} — gestão pública do turismo com base em dados`,
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f263f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.nome} href={new URL('/rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...seo} ogImage={ogImage ?? imagemPadrao} noindex={seo.noindex || rascunho} />

    <!-- Google Analytics (GA4) — tag gtag padrão; a biblioteca é baixada após o carregamento da página
         para não competir com o conteúdo (Lighthouse). A pageview é registrada normalmente. -->
    <script is:inline define:vars={{ id: SITE.ga4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', id);
      window.addEventListener('load', function () {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
        document.head.appendChild(s);
      });
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2"
      >Pular para o conteúdo</a
    >
    {
      rascunho && (
        <div class="bg-amber-100 px-4 py-2 text-center text-sm font-semibold text-amber-950" role="status">
          RASCUNHO — visível só na pré-visualização local. Não é publicado enquanto estiver com draft: true.
        </div>
      )
    }
    <Header />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
