{
  "name": "blog-dataturismo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "build": "node node_modules/astro/bin/astro.mjs check && node node_modules/astro/bin/astro.mjs build",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "build:drafts": "SHOW_DRAFTS=true node node_modules/astro/bin/astro.mjs build",
    "preview:drafts": "SHOW_DRAFTS=true node node_modules/astro/bin/astro.mjs build && node node_modules/astro/bin/astro.mjs preview",
    "check": "node node_modules/astro/bin/astro.mjs check",
    "astro": "node node_modules/astro/bin/astro.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
